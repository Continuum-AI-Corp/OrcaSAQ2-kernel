# 16 GB card (RTX 5080 / 4080 / 4060 Ti 16G). Every number below was measured on this
# checkpoint under a 15.5 GiB cap, not estimated.
#
#   KV pool      59,753 tokens        single stream  64.5 tok/s        VRAM 15.5 GB
#
# Those three came from a run at MAXLEN=16384. This preset ships 32768 because the context is
# worth more than the pool figure, but the pool at 32K has NOT been measured separately and will
# be smaller -- do not quote 59,753 for it. Set MAXLEN=16384 to reproduce the row exactly.
#
# The usual vLLM throughput advice moves these the other way, because it assumes KV is
# plentiful. Here it is not: CUDA-graph capture, block tables and activation peaks all compete
# with the context length the user actually gets.
MAXLEN=32768
GPU_FRAC=0.95
MAXSEQS=4               # 8 costs 30% of the context for concurrency a 16 GB card cannot use
MAXBATCHTOK=2048        # caps the activation peak
KV_DTYPE=fp8_e4m3       # +59% context, no measurable speed or quality cost
BLOCK_SIZE=32           # +41% KV. The default 16 is too fine for a 1:3 hybrid attention stack
PREFIX_CACHE=1
KV_OFFLOAD_GB=8         # does NOT grow the GPU pool; keeps evicted prefixes out of recompute
# EAGER=1               # never. Measured 2.4x slower AND 2 GB larger.
# Chat features. The reasoning parser splits the thinking block out of the reply so eval
# harnesses and agents do not have to strip it. The tool parser must match what the chat
# template emits: this model writes the Qwen3 XML form, so qwen3_xml, not hermes. serve.sh
# pairs TOOL_PARSER with --enable-auto-tool-choice, which the flag is inert without.
REASONING_PARSER=qwen3
TOOL_PARSER=qwen3_xml
# BIND is deliberately not set here. Network exposure is a deployment decision, not a
# property of the card: serve.sh defaults to loopback, the Docker entrypoint to 0.0.0.0
# (where the published port and the host firewall are the boundary). Set BIND=0.0.0.0
# on a host only with API_KEY and a firewall whitelist already in place.
